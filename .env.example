# 本地开发可留空，默认使用 http://localhost:3000。
# 生产构建前填写完整公网地址，例如 https://example.com。
SITE_URL=

# 远程 PostgreSQL 连接串（如 Vercel Postgres / Neon / Supabase / Docker Postgres）。
# 必须以 postgres:// 或 postgresql:// 开头；留空则使用本地嵌入式 PGlite（.data/pgdata）。
DATABASE_URL=

# 仅在未设置 DATABASE_URL 时生效：本地 PGlite 数据目录，默认 .data/pgdata。
DATABASE_PATH=

# 可选，本地持久化目录（存放自动生成的 auth-secret 与本地 media/）；默认取 DATABASE_PATH 所在目录。
DATA_DIR=

# Better Auth 会话签名密钥。无服务器/Vercel 部署建议显式填写随机长密钥；
# 留空时将在 DATA_DIR 下自动生成并复用 auth-secret 文件。
AUTH_SECRET=

# GitHub OAuth App 的 Client ID 和 Client Secret。
# 回调地址为 SITE_URL 对应站点的 /api/auth/callback/github。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 唯一管理员的 GitHub 数字账号 ID，不是用户名，也不是上面的 Client ID。
ADMIN_GITHUB_ID=

# 可选 S3 / Cloudflare R2 / MinIO 对象存储配置。
# 设置 S3_BUCKET 后自动切换为对象存储；留空则保存到本地 DATA_DIR/media/。
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=media
S3_FORCE_PATH_STYLE=false
