# 本地开发可留空，默认使用 http://localhost:3000。
# 生产构建前填写完整公网地址，例如 https://example.com。
SITE_URL=

# 本地数据库默认使用 .data/nim.sqlite，VPS 可指定固定的持久化文件路径。
DATABASE_PATH=

# GitHub OAuth App 的 Client ID 和 Client Secret。
# 回调地址为 SITE_URL 对应站点的 /api/auth/callback/github。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 唯一管理员的 GitHub 数字账号 ID，不是用户名，也不是上面的 Client ID。
ADMIN_GITHUB_ID=

# 使用随机生成的至少 32 字节密钥，供管理员会话加密使用。
AUTH_SECRET=
